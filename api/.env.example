# --- Server ---
PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=svbk
# Schema changes go through migrations. Leave DB_SYNC unset (or false)
# unless you're explicitly bootstrapping a fresh dev DB.
DB_SYNC=false

# --- JWT ---
# Access token expiry in SECONDS. Keep short (15m) — refresh handles the rest.
JWT_SECRET=change_me
JWT_EXPIRES_IN=900
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800

# --- Parent OTP login ---
OTP_EXPIRES_IN_MINUTES=5
DEMO_MODE=true   # any 6-digit code works; OTPs are logged, not emailed

# --- SMTP for OTP delivery (used when DEMO_MODE=false) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SVBK <no-reply@svbk.edu.in>
SMTP_ALLOW_INSECURE=false

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- Cloudinary (optional, for media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web client URL (used for emails / templating) ---
CLIENT_URL=http://localhost:3000

# --- CORS — comma-separated origins. Use "*" or leave empty to allow all (dev only). ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003

# --- Chatbot ---
# Rule-based path runs free; LLM fallback is off by default. Flip
# CHATBOT_LLM_ENABLED + supply the model + key when you're ready.
CHATBOT_RULE_CONFIDENCE=0.5
CHATBOT_HISTORY_TURNS=6
CHATBOT_RATE_PER_MINUTE=30
CHATBOT_TENANT_DAILY_TOKENS=100000
CHATBOT_CONVERSATION_RETENTION_DAYS=90
CHATBOT_SSE_PING_MS=25000
CHATBOT_SSE_MAX_DURATION_MS=60000
CHATBOT_LLM_ENABLED=false
CHATBOT_LLM_MODEL=
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_TIMEOUT_MS=10000

# --- DB connection pool (override defaults for prod scale) ---
DB_POOL_MAX=30
DB_POOL_MIN=5
