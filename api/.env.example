# --- Server ---
PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=svbk
DB_SYNC=true

# --- JWT ---
JWT_SECRET=change_me
JWT_EXPIRES_IN=86400
JWT_REFRESH_SECRET=change_me_refresh
JWT_REFRESH_EXPIRES_IN=604800

# --- Parent OTP login ---
OTP_EXPIRES_IN_MINUTES=5
DEMO_MODE=true   # any 6-digit code works; OTPs are logged, not emailed

# --- SMTP for OTP delivery (used when DEMO_MODE=false) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SVBK <no-reply@svbk.edu.in>
SMTP_ALLOW_INSECURE=false

# --- Payments (optional) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# --- Cloudinary (optional, for media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Web client URL (used for emails / templating) ---
CLIENT_URL=http://localhost:3000

# --- CORS — comma-separated origins. Use "*" or leave empty to allow all (dev only). ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003
